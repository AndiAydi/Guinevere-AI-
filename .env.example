# ─────────────────────────────────────────────────────────────
# Guinevere AI — contoh environment. SALIN ke .env (jangan commit).
# Semua layanan di bawah punya free tier tanpa kartu kredit.
# ─────────────────────────────────────────────────────────────

# Provider AI (semua opsional — yang tersedia akan dipakai otomatis)

# Groq — provider PRIMARY. 30 RPM, 1.000 RPD, 200K token/hari per model.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — provider SECONDARY + Google Search grounding.
# Indonesia termasuk region yang didukung.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# OpenRouter — provider TERTIARY. Hanya 50 request/hari (gratis).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas M0 (512 MB, free, no card). Lokal: mongodb://localhost:27017
MONGODB_URI=
MONGODB_DB_NAME=guinevere

# ─────────────────────────────────────────────────────────────
# Sandbox eksekusi kode
# ─────────────────────────────────────────────────────────────

# E2B Hobby ($100 credit sekali, tanpa kartu kredit)
# https://e2b.dev/dashboard
E2B_API_KEY=
E2B_TEMPLATE=base

# Daytona — fallback ($200 credit)
DAYTONA_API_KEY=

# auto | e2b | daytona | local
SANDBOX_PROVIDER=auto
SANDBOX_TIMEOUT_MS=300000

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=4111
NODE_ENV=development
LOG_LEVEL=info

# Maks request per jam sebelum auto-turunkan model (0 = matikan)
RATE_LIMIT_REQUESTS_PER_HOUR=0

# Umur data audit (hari)
TOOL_AUDIT_TTL_DAYS=30
